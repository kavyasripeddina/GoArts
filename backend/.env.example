# GoArts Backend - Production / Render / MongoDB Atlas Environment Configuration Template
NODE_ENV=production
PORT=5000

# Secure JWT configuration (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_secret_minimum_64_characters
JWT_EXPIRES_IN=7d

# Allowed frontend origin (Set to your Vercel URL, e.g. https://your-project.vercel.app)
# You can also supply multiple comma-separated URLs: https://my-app.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-goarts-frontend.vercel.app

# MongoDB Atlas Connection URI
# 1. Sign up on https://www.mongodb.com/cloud/atlas (Free M0 Cluster)
# 2. In Atlas -> Network Access: Add IP Access List '0.0.0.0/0' (Allow access from anywhere so Render can connect)
# 3. In Atlas -> Database Access: Create a database user & password (URL-encode special characters in password)
# 4. In Atlas -> Clusters -> Connect -> Drivers -> copy connection string:
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/goarts?retryWrites=true&w=majority
DB_NAME=goarts

# Super Admin Bootstrap Credentials
ADMIN_EMAIL=admin@goarts.ai
ADMIN_PASSWORD=ADMIN_PASSWORD=replace_with_a_secure_admin_password

# Google Gemini AI API Key (Enables AI matchmaking, talent scoring, and event planning)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# ============================================================
# Microsoft Azure Cloud Services Suite
# ============================================================

# 1. Azure OpenAI (Chat Completions & Event Planning with GPT-4o / GPT-4o-mini / GPT-3.5)
# Obtain from: Azure Portal -> Azure OpenAI Service -> Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# 2. Azure AI Vision (Performer Portrait Analysis, Facial Verification & Content Safety)
# Obtain from: Azure Portal -> Azure AI Services -> Computer Vision -> Keys and Endpoint
AZURE_VISION_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com
AZURE_VISION_KEY=your_azure_ai_vision_key
AZURE_VISION_API_VERSION=2024-02-01

# 3. Azure Maps (Indian Venue Geocoding, Search & Artist Travel Logistics)
# Obtain from: Azure Portal -> Azure Maps Account -> Authentication -> Primary Key
AZURE_MAPS_KEY=your_azure_maps_subscription_primary_key

# 4. Azure Media Services (Demo Reel Transcoding, Video Streaming Profiles & HLS)
AZURE_MEDIA_ENDPOINT=https://<your-media-account>.mediaservices.azure.com
AZURE_MEDIA_KEY=your_azure_media_primary_key
