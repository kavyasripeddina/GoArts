# GoArts Frontend - Environment Configuration Template
# In local development:
# VITE_API_BASE_URL=http://localhost:5000/api
#
# In production on Vercel:
# Set this to your live Render backend API URL (including /api):
# VITE_API_BASE_URL=https://goarts-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Azure Maps Client Key (Optional - for interactive Azure maps in frontend)
VITE_AZURE_MAPS_KEY=your_azure_maps_subscription_primary_key
